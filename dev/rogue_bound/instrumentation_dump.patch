+// [[Rcpp::export]]
+NumericVector instr_get(const bool reset) {
+  NumericVector ret(instr::N_TIMER + instr::N_COUNT);
+  for (int i = 0; i != instr::N_TIMER; ++i) ret[i] = double(instr::ticks[i]);
+  for (int i = 0; i != instr::N_COUNT; ++i) ret[instr::N_TIMER + i] = double(instr::counts[i]);
+  if (reset) {
+    for (auto &t : instr::ticks) t = 0;
+    for (auto &c : instr::counts) c = 0;
+  }
+  return ret;
