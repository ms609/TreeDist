@@ -0,0 +1,32 @@
+// Instrumentation for bound research (scratch only).
+#ifndef TREEDIST_INSTR_H_
+#define TREEDIST_INSTR_H_
+#include <x86intrin.h>
+#include <cstdint>
+#include <cstdio>
+
+namespace instr {
+enum Timer {
+  T_TOTAL, T_KAR, T_SPLITS, T_FMS, T_BCID, T_MCI_SETUP, T_MCI_FILL,
+  T_MCI_COPY, T_MCI_LAP, T_MCI_TAIL, T_HALF_KAR, T_PARENT, N_TIMER
+};
+enum Count {
+  C_CALLS, C_ENTROPY, C_ROW, C_EXACT, C_LAP, C_LAP_BELOW, C_WHOLE, C_HALF1,
+  C_HALF2, C_CANDIDATES, C_EXTRA_EXIT, N_COUNT
+};
+inline uint64_t ticks[N_TIMER] = {};
+inline uint64_t counts[N_COUNT] = {};
+inline FILE *dump = nullptr;
+inline int cand_id = -1;
+inline int call_kind = -1;
+inline bool lap_below_last = false;
+
+struct Scope {
+  int t;
+  uint64_t s;
+  explicit Scope(int timer) : t(timer), s(__rdtsc()) {}
+  ~Scope() { ticks[t] += __rdtsc() - s; }
+};
+}
+
+#endif
